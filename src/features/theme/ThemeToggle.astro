---
// Light/dark toggle. The initial theme is applied before paint by the inline
// script in BaseLayout; this button only flips it and stores the choice.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    'theme-toggle flex items-center justify-center size-11 rounded-full hover:bg-[var(--color-action-hover)] transition-colors duration-150',
    className,
  ]}
  aria-label="다크 모드로 전환"
>
  <!-- Moon: shown in light mode (action = go dark) -->
  <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <!-- Sun: shown in dark mode (action = go light) -->
  <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
</button>

<style>
  .theme-toggle .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle .icon-sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .theme-toggle .icon-moon {
    display: none;
  }
</style>

<script>
  import { applyTheme, getTheme, setTheme } from './theme';

  function syncButtons() {
    const isDark = getTheme() === 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-label', isDark ? '라이트 모드로 전환' : '다크 모드로 전환');
    });
  }

  // Delegated once on document, so it keeps working after client-side navigations.
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target?.closest('[data-theme-toggle]')) return;
    const next = getTheme() === 'dark' ? 'light' : 'dark';
    setTheme(next);
    applyTheme(next);
    syncButtons();
  });

  document.addEventListener('astro:page-load', syncButtons);
  document.addEventListener('theme:change', syncButtons);
</script>
