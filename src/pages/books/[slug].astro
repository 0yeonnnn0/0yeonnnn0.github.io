---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/app/layouts/BaseLayout.astro';
import PostList from '@/widgets/post-list/PostList.astro';
import { getBooksWithPosts } from '@/shared/lib/posts';

// 공개 글이 없는 책은 페이지를 만들지 않는다.
export const getStaticPaths = (async () => {
  const books = await getBooksWithPosts();
  return books.map(({ book, posts }) => ({
    params: { slug: book.id },
    props: { book, posts },
  }));
}) satisfies GetStaticPaths;

const { book, posts } = Astro.props;
---

<BaseLayout title={book.data.title} description={book.data.description}>
  <div class="max-w-[800px] mx-auto">
    <header class="mb-5">
      <h1 class="font-body text-[clamp(1.8rem,3.5vw,2.5rem)] font-bold leading-[1.25] tracking-[-0.016em] text-[var(--color-text-primary)]">
        {book.data.title}
      </h1>
      <p class="font-ui text-lg text-[var(--color-text-secondary)] mt-1">
        {book.data.description}
      </p>
      <p class="font-ui text-sm text-[var(--color-text-secondary)] mt-0.5">
        {posts.length}편의 글
      </p>
    </header>

    <PostList posts={posts} numbered />
  </div>
</BaseLayout>
