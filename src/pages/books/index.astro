---
import BaseLayout from '@/app/layouts/BaseLayout.astro';
import PageTitle from '@/shared/ui/PageTitle.astro';
import BookCover from '@/widgets/book-list/BookCover.astro';
import { getBooksWithPosts } from '@/shared/lib/posts';

const books = await getBooksWithPosts();
---

<BaseLayout title="Books" description="주제별로 묶은 글 시리즈">
  <div class="max-w-[1000px] mx-auto">
    <PageTitle class="mb-2">Books</PageTitle>
    <p class="font-ui text-[var(--color-text-secondary)] mb-5">
      주제별로 묶은 글 시리즈입니다.
    </p>

    {books.length === 0 ? (
      <p class="font-ui text-[var(--color-text-secondary)]">아직 공개된 시리즈가 없습니다.</p>
    ) : (
      <ul class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-5">
        {books.map(({ book, posts }, i) => (
          <li>
            <a href={`/books/${book.id}/`} class="group flex flex-col no-underline">
              <BookCover book={book} index={i} />
              <p class="font-ui text-sm text-[var(--color-text-secondary)] mt-1">
                {posts.length} chapters
              </p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
