---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/app/layouts/BaseLayout.astro';
import PageTitle from '@/shared/ui/PageTitle.astro';
import PostList from '@/widgets/post-list/PostList.astro';
import { CATEGORIES } from '@/data/categories';
import { getPublishedPosts } from '@/shared/lib/posts';

// 공개 글이 있는 카테고리만 페이지를 만든다.
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return CATEGORIES.map((category) => ({
    category,
    posts: posts.filter((p) => p.data.category === category),
  }))
    .filter(({ posts }) => posts.length > 0)
    .map(({ category, posts }) => ({
      params: { category },
      props: { category, posts },
    }));
}) satisfies GetStaticPaths;

const { category, posts } = Astro.props;
---

<BaseLayout title={category} description={`"${category}" 카테고리의 글 목록`}>
  <div class="max-w-[800px] mx-auto">
    <a href="/categories/" class="inline-block font-ui text-sm text-[var(--color-text-secondary)] no-underline hover:underline mb-2">← 전체 카테고리</a>
    <PageTitle>{category}</PageTitle>
    <PostList posts={posts} columns={2} />
  </div>
</BaseLayout>
