---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/app/layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPublishedPosts } from '@/shared/lib/posts';
import { formatDate } from '@/shared/lib/date';
import { getReadingTime } from '@/shared/lib/reading-time';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const readingTime = getReadingTime(post.body);
// 초안은 dev에서만 노출된다(프로덕션 빌드에서는 getPublishedPosts가 제외).
const isDraft = import.meta.env.DEV && post.data.draft;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.thumbnail?.src}
  type="article"
  publishedTime={post.data.date.toISOString()}
>
  <article class="max-w-[800px] mx-auto">
    <header class="mb-5">
      <div class="flex items-center gap-1 font-ui text-[0.92rem] text-[var(--color-text-secondary)] mb-1.5">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">&middot;</span>
        <span>{readingTime}분 읽기</span>
      </div>
      <h1 class="font-body text-[clamp(1.8rem,3.5vw,2.5rem)] font-bold leading-[1.25] tracking-[-0.016em] text-[var(--color-text-primary)]">
        {post.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-1 mt-2 font-ui text-sm text-[var(--color-text-secondary)]">
        <a
          href={`/categories/${encodeURIComponent(post.data.category)}/`}
          class="text-[var(--color-text-secondary)] no-underline hover:underline"
        >
          {post.data.category}
        </a>
        {isDraft && <span class="font-ui text-xs uppercase tracking-wide border border-[var(--color-divider)] rounded-[2.5px] px-1.5 text-[var(--color-text-secondary)]">Draft</span>}
        {post.data.tags.length > 0 && (
          <>
            <span aria-hidden="true">&middot;</span>
            {post.data.tags.map((tag) => (
              <a
                href={`/tags/${encodeURIComponent(tag)}/`}
                class="text-[var(--color-secondary)] no-underline hover:underline"
              >
                #{tag}
              </a>
            ))}
          </>
        )}
      </div>
    </header>

    <div class="prose font-body text-[1rem] leading-[1.8] text-[var(--color-text-primary)]">
      <Content />
    </div>
  </article>
</BaseLayout>
