---
import BaseLayout from '@/app/layouts/BaseLayout.astro';
import PageTitle from '@/shared/ui/PageTitle.astro';
import PostList from '@/widgets/post-list/PostList.astro';
import { getPublishedPosts } from '@/shared/lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="Posts" description="전체 글 목록">
  <div class="max-w-[800px] mx-auto">
    <PageTitle>Posts</PageTitle>

    {posts.length === 0 ? (
      <p class="font-ui text-[var(--color-text-secondary)]">아직 작성된 글이 없습니다.</p>
    ) : (
      <PostList posts={posts} />
    )}
  </div>
</BaseLayout>
