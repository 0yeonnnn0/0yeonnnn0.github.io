---
import BaseLayout from '@/app/layouts/BaseLayout.astro';
import PageTitle from '@/shared/ui/PageTitle.astro';
import { getPublishedPosts } from '@/shared/lib/posts';

const posts = await getPublishedPosts();
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
// 글 수 내림차순, 같으면 이름순
const tags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'),
);
---

<BaseLayout title="Tags" description="태그 목록">
  <div class="max-w-[800px] mx-auto">
    <PageTitle>Tags</PageTitle>

    {tags.length === 0 ? (
      <p class="font-ui text-[var(--color-text-secondary)]">아직 태그가 없습니다.</p>
    ) : (
      <ul class="flex flex-wrap gap-1.5">
        {tags.map(([tag, count]) => (
          <li>
            <a
              href={`/tags/${encodeURIComponent(tag)}/`}
              class="block font-ui text-sm px-2 py-1 rounded-[5px] border border-[var(--color-divider)] text-[var(--color-text-secondary)] no-underline hover:bg-[var(--color-action-hover)] transition-colors"
            >
              #{tag} <span class="text-[var(--color-text-secondary)]">({count})</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
