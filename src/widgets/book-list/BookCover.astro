---
import { Image } from 'astro:assets';
import type { Book } from '@/shared/lib/posts';
import { SITE } from '@/shared/config/site';

interface Props {
  book: Book;
  /** 표지 이미지가 없을 때 배경 그라디언트를 고르는 순번 */
  index: number;
}

const { book, index } = Astro.props;

const bgColors = [
  'from-[#e8e0d0] to-[#d5c6b0]',
  'from-[#5a7a7e] to-[#4a6568]',
  'from-[#b8c8cc] to-[#8fa8ab]',
  'from-[#c8c4d8] to-[#a8a0c0]',
  'from-[#4a8a8e] to-[#3a7a7e]',
  'from-[#d8d0c0] to-[#c0b8a8]',
];
---

<div class="relative w-full aspect-[3/4] rounded-[3px] overflow-hidden shadow-[0_4px_16px_rgba(0,0,0,0.12)]">
  {book.data.cover ? (
    <Image
      src={book.data.cover}
      alt=""
      widths={[320, 640]}
      sizes="160px"
      class="absolute inset-0 w-full h-full object-cover"
    />
  ) : (
    <div class={`absolute inset-0 bg-gradient-to-br ${bgColors[index % bgColors.length]}`} />
  )}

  <!-- 표지 위 제목 카드 -->
  <div class="absolute inset-x-[14%] inset-y-[18%] bg-[var(--color-card)] shadow-[0_2px_10px_rgba(0,0,0,0.1)] flex flex-col justify-between px-1.5 pt-1.5 pb-2.5">
    <p class="font-body text-[0.8rem] font-bold leading-[1.4] text-[var(--color-text-primary)] line-clamp-3">
      {book.data.title}
    </p>
    <p class="font-ui text-[0.7rem] text-[var(--color-text-secondary)]">
      {SITE.author}
    </p>
  </div>
</div>
