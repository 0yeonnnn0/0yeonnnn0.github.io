---
import { getBooksWithPosts } from '@/shared/lib/posts';
import BookCover from './BookCover.astro';

const books = await getBooksWithPosts();
---

{books.length > 0 && (
  <section>
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-body text-[1.5rem] font-bold leading-[1.6]">
        Books
      </h2>
      <a
        href="/books/"
        class="font-body text-base text-[var(--color-text-secondary)] no-underline hover:underline"
      >
        View all &rarr;
      </a>
    </div>

    <ul class="flex gap-5 overflow-x-auto pb-3 -mx-2 px-2 snap-x snap-mandatory scrollbar-hide">
      {books.map(({ book }, i) => (
        <li class="flex-shrink-0 w-[140px] sm:w-[155px] snap-start">
          <a href={`/books/${book.id}/`} class="group block no-underline">
            <BookCover book={book} index={i} />
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
