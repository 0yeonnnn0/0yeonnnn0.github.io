---
import { getPublishedPosts } from '@/shared/lib/posts';
import PostList from './PostList.astro';

interface Props {
  limit?: number;
}

const { limit = 6 } = Astro.props;

const posts = (await getPublishedPosts()).slice(0, limit);
---

{posts.length > 0 && (
  <section>
    <h2 class="font-body text-[1.5rem] font-bold leading-[1.6] mb-3">
      Recent Posts
    </h2>
    <PostList posts={posts} />
  </section>
)}
