---
import { getPublishedPosts, type Post } from '@/shared/lib/posts';
import { STEADY_SELLERS } from '@/data/steady-sellers';

const postsById = new Map((await getPublishedPosts()).map((post) => [post.id, post]));
const steadyPosts = STEADY_SELLERS
  .slice(0, 10)
  .map((slug) => postsById.get(slug))
  .filter((post): post is Post => post !== undefined);
---

{steadyPosts.length > 0 && (
  <section>
    <h2 class="font-body text-[1.5rem] font-bold leading-[1.6] mb-3">
      Steady Sellers
    </h2>
    <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-3 gap-y-0">
      {steadyPosts.map((post, i) => (
        <li>
          <a
            href={`/posts/${post.id}/`}
            class="flex items-center gap-4 px-5 py-5 rounded-[5px] no-underline transition-colors duration-200 ease-in-out hover:bg-[var(--color-row-hover)]"
          >
            <span
              aria-hidden="true"
              class="font-body text-3xl font-light leading-none text-[var(--color-text-muted)] w-5 shrink-0 text-center"
            >
              {i + 1}
            </span>
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="font-body text-[1.0rem] font-bold leading-[1.4] text-[var(--color-text-primary)] truncate">
                {post.data.title}
              </span>
              <span class="font-ui text-[0.9rem] leading-[1.3] text-[var(--color-text-secondary)]">
                {post.data.category}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
)}
